# -------------------------------------------------------------
# Google Gemini Configuration (Set this if using Google Gemini)
# -------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LLM_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# -------------------------------------------------------------
# Groq Configuration (Ultra-fast inference via Groq LPU)
# -------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_LLM_MODEL=openai/gpt-oss-120b

# -------------------------------------------------------------
# OpenAI Configuration (Set this if using OpenAI)
# -------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# -------------------------------------------------------------
# Provider Choice: "gemini", "groq", or "openai" (or leave empty for auto-detect)
# -------------------------------------------------------------
LLM_PROVIDER=gemini

# -------------------------------------------------------------
# RAG Pipeline Configuration
# -------------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4

# -------------------------------------------------------------
# Vector Store & Server Configuration
# -------------------------------------------------------------
CHROMA_PERSIST_DIRECTORY=./chroma_db
HOST=127.0.0.1
PORT=8000
